        <mxCell id="QYVWqjrwugcvQBpgwcZD-13" parent="1" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#A855F7;fontStyle=1;fontSize=14;fontColor=#581C87;rounded=1;shadow=1;" value="4. 核心領域服務與運算引擎層 (Core Domain &amp; Infrastructure Layer) — Functions.gs" vertex="1">
