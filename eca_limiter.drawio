        </mxCell>
        <mxCell id="QYVWqjrwugcvQBpgwcZD-11" parent="QYVWqjrwugcvQBpgwcZD-10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F59E0B;strokeWidth=2;fontSize=12;fontColor=#1E293B;align=left;spacingLeft=15;" value="Config.gs (系統環境常數)&#xa;• FORM_ID : 表單唯一識別碼&#xa;• DEFAULT_LIMIT : 默認名額 (20)&#xa;• SCHEDULE_CONFIG : 開啟/關閉排程&#xa;• CLOSED_FORM_MESSAGE : 提示訊息" vertex="1">
          <mxGeometry height="75" width="320" x="120" y="40" as="geometry" />
