        <mxCell id="QYVWqjrwugcvQBpgwcZD-10" parent="1" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontStyle=1;fontSize=14;fontColor=#78350F;rounded=1;shadow=1;" value="3. 系統設定與業務契約層 (Configuration &amp; Domain Contract)" vertex="1">
